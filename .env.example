# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

# The public origin of the app, e.g. https://bodyledger.example.com
# Better Auth derives its trusted origins AND the `Secure` cookie flag from
# this, so in production it must be the real https URL — an http value here
# silently ships an insecure session cookie.
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Resend — password reset email
# https://resend.com/api-keys
# onboarding@resend.dev only delivers to the Resend account owner.
RESEND_API_KEY=""
RESEND_FROM="Body Ledger <onboarding@resend.dev>"

# Optional. Only read by `pnpm admin:bootstrap` to pick which account to
# promote to site admin; the app itself never reads it.
ADMIN_EMAIL=""
